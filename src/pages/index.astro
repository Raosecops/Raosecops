---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config';

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => {
    const dateA = new Date(a.data.date || a.data.pubDate || 0).valueOf();
    const dateB = new Date(b.data.date || b.data.pubDate || 0).valueOf();
    return dateB - dateA;
  })
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Base>
<section class="hero" style="border-top:0">
  <div class="wrap">
    <div class="hero-grid">
      <div>
        <span class="chip">Server hardening, cloud security, web app testing</span>
        <h1>Hardening systems. Testing defenses.</h1>
        <p class="lead">I'm Rao, a computer science graduate and cybersecurity practitioner. I help businesses secure their Linux servers, cloud infrastructure, and web applications through hands-on penetration testing and practical hardening, not checkbox audits.</p>
        <div class="actions">
          <a class="btn primary" href="/#contact">Start a conversation</a>
          <a class="btn" href="/#services">See what I do</a>
        </div>
      </div>
      <div aria-hidden="true">
        <div class="term">
          <div class="bar"><span class="r"></span><span class="y"></span><span class="g"></span></div>
          <pre><code>rao@Ubuntulab:~$ nmap -T4 -A -v raosecops.com
Starting Nmap scan at 2026-11-03 23:19 TRT
Host is up (0.00012s latency).
PORT    STATE SERVICE  VERSION
22/tcp  open  ssh      OpenSSH 9.6p1
80/tcp  open  http     nginx
443/tcp open  ssl/http nginx
Nmap done: 1 IP address scanned.</code></pre>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="services">
  <div class="wrap">
    <h2>Core Engineering Services</h2>
    <p class="section-sub">Offensive testing meets defensive architecture. Built for production environments.</p>
    <div class="grid">
      <div class="card">
        <h3>Linux Server Hardening</h3>
        <p>Systemd auditing, sysctl kernel hardening, UFW firewall enforcement, Fail2ban intrusion prevention, and socket attack surface reduction.</p>
      </div>
      <div class="card">
        <h3>Cloud Security & DevSecOps</h3>
        <p>AWS IAM least-privilege auditing, Terraform compliance gates, Checkov static analysis CI/CD pipelines, and zero-trust infrastructure.</p>
      </div>
      <div class="card">
        <h3>Web Application Pen Testing</h3>
        <p>Burp Suite vulnerability assessments, OWASP Top 10 auditing, authentication flow analysis, and secure API design reviews.</p>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <h2>Latest Security Write-ups</h2>
    <p class="section-sub">Practical guides and technical documentation from my research lab.</p>
    <div class="grid">
      {posts.map((post) => (
        <a class="card post-card" href={`/blog/${post.id}/`}>
          <div class="meta">{fmt(new Date(post.data.date || post.data.pubDate))}</div>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<section id="contact">
  <div class="wrap contact-box">
    <h2>Let's Secure Your Infrastructure</h2>
    <p>Need a security assessment, Linux hardening, or cloud architecture review? Get in touch directly.</p>
    <div class="actions" style="margin-top:1.5rem">
      <a class="btn primary" href="mailto:contact@raosecops.com">Email contact@raosecops.com</a>
      <a class="btn" href="https://github.com/raosecops" target="_blank" rel="noopener">GitHub @raosecops</a>
    </div>
  </div>
</section>
</Base>
