---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Base title="Blog" description="Technical write-ups on Linux, cloud security and web application testing.">
  <div class="wrap page-head">
    <h1>Blog</h1>
    <p>Notes on Linux, cloud security and web application testing.</p>
  </div>
  <section class="blog-list">
    <div class="wrap">
      {posts.length === 0 ? (
        <p>No posts yet. Check back soon.</p>
      ) : (
        <ul class="post-list">
          {posts.map((p) => (
            <li>
              <a href={`/blog/${p.id}/`}>
                <span class="meta">{fmt(p.data.date)}{p.data.tags.length > 0 && ` · ${p.data.tags.join(', ')}`}</span>
                <h3>{p.data.title}</h3>
                <p>{p.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>
